+const watchers = new Map;
+export function watchGeometry(win, update) {
+  if (typeof win.requestAnimationFrame !== "function")
+    return () => {};
+  let callbacks = watchers.get(win);
+  if (!callbacks) {
+    callbacks = new Set;
+    watchers.set(win, callbacks);
+    const tick = () => {
+      const current = watchers.get(win);
+      if (!current?.size) {
+        watchers.delete(win);
+        return;
+      }
+      for (const callback of [...current])
+        callback();
+      win.requestAnimationFrame(tick);
+    };
+    win.requestAnimationFrame(tick);
+  }
+  callbacks.add(update);
+  return () => {
+    callbacks.delete(update);
+  };
+}
+export function geometryScale(node) {
+  const rect = node.getBoundingClientRect();
+  return { x: rect.width / node.offsetWidth || 1, y: rect.height / node.offsetHeight || 1 };
+}
+export function localSize(node) {
+  const rect = node.getBoundingClientRect(), scale = geometryScale(node);
+  return { width: rect.width / scale.x, height: rect.height / scale.y };
+}
+export function localPoint(parent, x, y) {
+  const rect = parent.getBoundingClientRect(), scale = geometryScale(parent);
+  return {
+    x: (x - rect.left) / scale.x - parent.clientLeft + parent.scrollLeft,
+    y: (y - rect.top) / scale.y - parent.clientTop + parent.scrollTop
+  };
+}
+export function observeFloating(reference, node, update) {
+  let last = "";
+  const measure = () => {
+    if (!node.isConnected)
+      return;
+    try {
+      const r = reference.getBoundingClientRect();
+      const p = node.offsetParent?.getBoundingClientRect();
+      const win = node.ownerDocument.defaultView;
+      const vp = win.visualViewport;
+      const bounds = [".milkdown", ".wm-canvas-stage"].map((selector) => node.closest(selector)?.getBoundingClientRect());
+      bounds.push(node.closest(".milkdown")?.querySelector(".milkdown-top-bar")?.getBoundingClientRect());
+      const menu = node.querySelector(".button-group");
+      const key = [
+        r.left,
+        r.top,
+        r.right,
+        r.bottom,
+        node.offsetWidth,
+        node.offsetHeight,
+        p?.left,
+        p?.top,
+        p?.width,
+        p?.height,
+        ...bounds.flatMap((b) => [b?.left, b?.right, b?.top, b?.bottom]),
+        menu?.getAttribute("data-show"),
+        win.scrollX,
+        win.scrollY,
+        win.innerWidth,
+        win.innerHeight,
+        vp?.offsetLeft,
+        vp?.offsetTop,
+        vp?.width,
+        vp?.height
+      ].join(":");
+      if (key !== last) {
+        last = key;
+        update();
+      }
+    } catch {}
+  };
+  measure();
+  const stop = watchGeometry(node.ownerDocument.defaultView, () => {
+    if (!node.isConnected || node.dataset.show === "false") {
+      stop();
+      return;
+    }
+    measure();
+  });
+  return stop;
+}
+export function fitFloating(node, reference) {
+  const win = node.ownerDocument.defaultView;
+  const vp = win.visualViewport;
+  const shell = node.closest(".milkdown");
+  const canvas = shell?.getBoundingClientRect();
+  const clip = node.closest(".wm-canvas-stage")?.getBoundingClientRect();
+  const toolbar = shell?.querySelector(".milkdown-top-bar")?.getBoundingClientRect();
+  const x = vp?.offsetLeft ?? 0, y = vp?.offsetTop ?? 0;
+  const left = Math.max(x, canvas?.left ?? x, clip?.left ?? x) + 8;
+  const right = Math.min(x + (vp?.width ?? win.innerWidth), canvas?.right ?? 1 / 0, clip?.right ?? 1 / 0) - 8;
+  const top = Math.max(y, toolbar?.bottom ?? y, clip?.top ?? y) + 8;
+  const bottom = Math.min(y + (vp?.height ?? win.innerHeight), clip?.bottom ?? 1 / 0) - 8;
+  const scale = geometryScale(node);
+  node.style.maxWidth = `${Math.max(1, right - left) / scale.x}px`;
+  const source = reference?.getBoundingClientRect();
+  const below = source ? bottom - source.bottom - 8 : bottom - top;
+  const above = source ? source.top - top - 8 : 0;
+  node.style.maxHeight = `${Math.max(1, source ? Math.max(below, above) : bottom - top) / scale.y}px`;
+  node.style.overflow = "auto";
+  const rect = node.getBoundingClientRect();
+  const dx = Math.max(left, Math.min(rect.left, right - rect.width)) - rect.left;
+  const desiredTop = source ? below >= rect.height || below >= above ? source.bottom + 8 : source.top - rect.height - 8 : rect.top;
+  const dy = Math.max(top, Math.min(desiredTop, bottom - rect.height)) - rect.top;
+  const parent = node.offsetParent;
+  const unit = parent ? geometryScale(parent) : { x: 1, y: 1 };
+  node.style.left = `${(parseFloat(node.style.left) || 0) + dx / unit.x}px`;
+  node.style.top = `${(parseFloat(node.style.top) || 0) + dy / unit.y}px`;
+}
