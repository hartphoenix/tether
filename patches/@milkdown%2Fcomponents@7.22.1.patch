+import { computePosition, type ComputePositionConfig, type ComputePositionReturn } from '@floating-ui/dom'
+import { observeFloating, fitFloating } from '@milkdown/plugin-tooltip'
+
+const positions = new WeakMap<HTMLElement, () => void>()
+/** One live placement per table control; new targets invalidate pending results. */
+export function trackTablePosition(reference: Element, node: HTMLElement, options: Partial<ComputePositionConfig>, apply: (position: ComputePositionReturn) => void) {
+  positions.get(node)?.()
+  let disposed = false, generation = 0
+  let stop = () => {}
+  const dispose = () => { disposed = true; generation++; stop() }
+  positions.set(node, dispose)
+  node.dataset.show = 'true'
+  stop = observeFloating(reference, node, () => {
+    const version = ++generation
+    if (!reference.isConnected) { node.dataset.show = 'false'; dispose(); return }
+    if (disposed || !reference.isConnected || !node.isConnected || node.dataset.show === 'false') return
+    computePosition(reference, node, options).then(position => {
+      if (disposed || version !== generation || !reference.isConnected || !node.isConnected || node.dataset.show === 'false') return
+      apply(position)
+      const menu = node.querySelector<HTMLElement>('.button-group')
+      if (menu) {
+        fitFloating(node)
+        node.style.overflow = 'visible'
+        if (menu.dataset.show === 'true') {
+          menu.style.transform = 'none'
+          menu.style.left = '0px'
+          menu.style.top = `${-menu.offsetHeight - 8}px`
+          fitFloating(menu)
+        }
+      }
+    }).catch(console.error)
+  })
+}
