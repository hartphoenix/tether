+export function liveLinkRect(view: EditorView, from: number, to: number, event: MouseEvent, lost: () => void) {
+  const link = event.target instanceof Element ? event.target.closest('a') : null
+  const fragments = link ? Array.from(link.getClientRects()) : []
+  const index = Math.max(0, fragments.findIndex(r => event.clientY >= r.top && event.clientY <= r.bottom && event.clientX >= r.left && event.clientX <= r.right))
+  return () => {
+    if (link && !link.isConnected) { lost(); return new DOMRect() }
+    const rects = link ? Array.from(link.getClientRects()) : []
+    const rect = rects[Math.min(index, rects.length - 1)] ?? posToDOMRect(view, from, to)
+    const toolbar = view.dom.closest('.milkdown')?.querySelector('.milkdown-top-bar')?.getBoundingClientRect()
+    if (rect.bottom < Math.max(0, toolbar?.bottom ?? 0) || rect.top > window.innerHeight) lost()
+    return rect
+  }
+}
