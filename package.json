{
  "name": "tether",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "tether": "./tether",
    "mdreview": "./mdreview"
  },
  "scripts": {
    "test": "bun test",
    "check": "bun test && bunx tsc --noEmit && bun run check:reader && bun run build:web",
    "check:reader": "bun scripts/check-reader-model.ts && bun scripts/check-reader-workflows.ts",
    "check:geometry": "bun scripts/check-geometry.ts && bun scripts/check-code-block-lifecycle.ts",
    "build:web": "bun build ./src/web/app.ts ./src/web/index.html --outdir ./dist --minify --splitting",
    "build:release": "bun scripts/build-release.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@lezer/highlight": "1.2.3",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "github-slugger": "2.0.0",
    "mermaid": "12.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tuf-js": "6.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tufjs/models": "5.0.0",
    "@types/bun": "^1.3.9",
    "@types/jsdom": "^27.0.0",
    "@types/retry": "0.12.5",
    "jsdom": "^29.1.1",
    "playwright": "1.62.1",
    "type-fest": "5.10.0",
    "typescript": "^5.9.2"
  },
  "patchedDependencies": {
    "@milkdown/plugin-tooltip@7.22.1": "patches/@milkdown%2Fplugin-tooltip@7.22.1.patch",
    "@milkdown/plugin-block@7.22.1": "patches/@milkdown%2Fplugin-block@7.22.1.patch",
    "@milkdown/plugin-slash@7.22.1": "patches/@milkdown%2Fplugin-slash@7.22.1.patch",
    "@milkdown/components@7.22.1": "patches/@milkdown%2Fcomponents@7.22.1.patch",
    "prosemirror-virtual-cursor@0.4.2": "patches/prosemirror-virtual-cursor@0.4.2.patch"
  }
}
